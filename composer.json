{
    "name": "brace/mod-spaserve",
    "type": "project",
    "description": "Serve Single Page Apps",
    "keywords": ["Phore", "Dependency Injection", "Di"],
    "homepage": "https://infracamp.org",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthias Leuffen",
            "email": "matthes@leuffen.de"
        }
    ],
    "require": {
        "php": ">=8.3",
        "brace/command": "*",
        "phore/filesystem": "*",
        "phore/system": "*",
        "phore/schema": "*"
    },
    "require-dev": {
        "brace/mod-request-laminas": "*",
        "phore/tester": "*",
        "phpspec/phpspec": "^7.5 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Brace\\SpaServe\\": "src"
        },
        "files": []
    },
    "autoload-dev": {
        "psr-4": {}
    },
    "scripts": {
        "test": "phpspec run"
    },
    "minimum-stability": "dev",
    "extra": {
        "branch-alias": {}
    }
}
